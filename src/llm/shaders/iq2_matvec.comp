                } else {
                    idx = byte_at(wd, 2u + l) | ((byte_at(wd, 66u + g) << (8u - 2u * k)) & 0x300u);
                    sg = byte_at(wd, 34u + l);
                    sc[l] = 1 + 2 * int((byte_at(wd, 74u + g) >> (4u * (k / 2u))) & 15u);
                }
                q[2u * l] = signed4(GS[2u * idx], sg & 15u);
                q[2u * l + 1u] = signed4(GS[2u * idx + 1u], sg >> 4);
            }
        for (uint v = 0; v < NV; v++) {
            uvec4 xr[NX];
            for (uint j = 0; j < NX; j++)
                xr[j] = X.v[xo[v] + min(j * SG + lane, 19u)];
            int isum = 0;
            for (uint g = 0; g < 8u; g++) {
                uvec4 a0 = bc(xr, 2u * g), a1 = bc(xr, 2u * g + 1u);
                uint l = 4u * g;
                isum += sc[l] * (dp(q[2u * l], a0.x) + dp(q[2u * l + 1u], a0.y));
                isum += sc[l + 1u] * (dp(q[2u * l + 2u], a0.z) + dp(q[2u * l + 3u], a0.w));
                isum += sc[l + 2u] * (dp(q[2u * l + 4u], a1.x) + dp(q[2u * l + 5u], a1.y));
                isum += sc[l + 3u] * (dp(q[2u * l + 6u], a1.z) + dp(q[2u * l + 7u], a1.w));
            }
            float d8 = uintBitsToFloat(bc(xr, 18u).x);
            acc[v] = fma(d * 0.125 * d8, float(isum), acc[v]);
            xo[v] += 20u;
        }
    }
    if (grow < p.rows)
        for (uint v = 0; v < NV; v++)
            if (v0 + v < p.nv)
                Y.v[(v0 + v) * p.ys + row] = acc[v];
}

/* byte i from byte off of w */
uint wbyte(U1 W, uint off, uint i)
{
    uint a = off + i;
    return (W.v[a >> 2] >> (8u * (a & 3u))) & 0xffu;
}

/* the four levels of a grid entry, each negated where its sign bit is set
   (bits 0-3 of s), as signed bytes */
uint signed4(uint g, uint s)
{
    uint r = 0u;
    [[unroll]] for (uint i = 0; i < 4u; i++) {
        int v = int((g >> (8u * i)) & 0xffu);
        if (((s >> i) & 1u) != 0u)
            v = -v;
        r |= (uint(v) & 0xffu) << (8u * i);
    }
    return r;
}

void main()
{
    U4 X = U4(p.x);
    U1 W = U1(p.w);
    F Y = F(p.y);
    uint id = gl_LocalInvocationID.x;
    uint r0 = gl_WorkGroupID.x * BM, v0 = gl_WorkGroupID.y * BN;
    uint warp = id / WARP, tiw = id % WARP;
    uint tiwr = tiw % (WM / TM), tiwc = tiw / (WM / TM);
    uint warp_r = warp % (BM / WM), warp_c = warp / (BM / WM);
    float sums[WNITER * TN * TM];
    [[unroll]] for (uint i = 0; i < WNITER * TN * TM; i++) sums[i] = 0.0;
    uint ngroups = p.nb * 8u;
    for (uint g0 = 0; g0 < ngroups; g0 += KS) {
        // weights: 4 invocations a row, 2 words each of the group's 8
        {
            uint iqs = id % 4u, rl = id / 4u;
            [[unroll]] for (uint l = 0; l < BM; l += 32u) {
                uint r = min(r0 + rl + l, p.rows - 1u);
                // the 4 groups staged are in one block (g0 is a multiple of 4)
                uint b = g0 / 8u, gb = g0 % 8u;
                uint off = (r * p.nb + b) * 110u;
                [[unroll]] for (uint k = 0; k < KS; k++) {
                    uint g = gb + k, qh = wbyte(W, off, 66u + g);
                    [[unroll]] for (uint t = 0; t < 2u; t++) {
                        uint kw = 2u * iqs + t;
                        uint idx = wbyte(W, off, 2u + 8u * g + kw) | (((qh >> kw) & 1u) << 8);
                        uint sg = wbyte(W, off, 74u + 4u * g + kw / 2u) >> (4u * (kw & 1u));
                        sa[k * BM + rl + l].qs[kw] = signed4(GRID[idx], sg & 15u);
                    }
                    if (iqs == 0u) {
                        float d = unpackHalf2x16(wbyte(W, off, 0u) | (wbyte(W, off, 1u) << 8)).x;
                        uint sc = (wbyte(W, off, 106u + g / 2u) >> (4u * (g & 1u))) & 15u;
                        sa[k * BM + rl + l].dsc = d * float(1 + 2 * int(sc));
                    }
                }
            }
        }
        // activations: 2 invocations a vector, each half a group's quants
        {
            uint iqs = id % 2u, c = id / 2u;
            uint v = min(v0 + c, p.nv - 1u);
            [[unroll]] for (uint k = 0; k < KS; k++) {
                uint g = g0 + k, b = g / 8u, G = g % 8u;
                uint xo = (v * p.xs + b) * XB;
                uvec4 q = X.v[xo + 2u * G + iqs];
                sb[k * BN + c].qs[4u * iqs] = int(q.x);
                sb[k * BN + c].qs[4u * iqs + 1u] = int(q.y);
                sb[k * BN + c].qs[4u * iqs + 2u] = int(q.z);
                sb[k * BN + c].qs[4u * iqs + 3u] = int(q.w);
                if (iqs == 0u)
                    sb[k * BN + c].d8 = uintBitsToFloat(X.v[xo + 18u].x);
            }
        }
        barrier();
        for (uint k = 0; k < KS; k++) {
            ACache ca[TM];
            [[unroll]] for (uint cr = 0; cr < TM; cr++)
                ca[cr] = sa[k * BM + warp_r * WM + tiwr * TM + cr];
            [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++)
                [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                    BCache cb = sb[k * BN + warp_c * WN + wsic * WSUBN + tiwc * TN + cc];
                    [[unroll]] for (uint cr = 0; cr < TM; cr++) {
                        int q = 0;
                        [[unroll]] for (uint i = 0; i < 8u; i++)
                            q += dotPacked4x8EXT(int(ca[cr].qs[i]), cb.qs[i]);
                        sums[(wsic * TN + cc) * TM + cr] += cb.d8 * ca[cr].dsc * float(q);
                    }
                }
        }
        barrier();
    }
    [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++)
        [[unroll]] for (uint cc = 0; cc < TN; cc++)
            [[unroll]] for (uint cr = 0; cr < TM; cr++) {
                uint row = r0 + warp_r * WM + tiwr * TM + cr;
                uint v = v0 + warp_c * WN + wsic * WSUBN + tiwc * TN + cc;
                if (row < p.rows && v < p.nv)
                    Y.v[v * p.ys + row] = sums[(wsic * TN + cc) * TM + cr];
            }
}

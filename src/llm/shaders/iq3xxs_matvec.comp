int dp(uint a, uint b) { return dotPacked4x8EXT(int(a), int(b)); }
uvec4 bc(uvec4 xr[NX], uint k) { return subgroupBroadcast(xr[k / SG], k % SG); }

uint byte_at(uint wd[NW], uint i) { return (wd[i >> 2] >> (8u * (i & 3u))) & 0xffu; }
uint half_at(uint wd[NW], uint i) { return byte_at(wd, i) | (byte_at(wd, i + 1u) << 8); }

uint signs7(uint i) { return i | ((uint(bitCount(i)) & 1u) << 7); }

uint signed4(uint g, uint s)
{
    uint r = 0u;
    for (uint i = 0; i < 4u; i++) {
        int v = int((g >> (8u * i)) & 0xffu);
        if (((s >> i) & 1u) != 0u)
            v = -v;
        r |= (uint(v) & 0xffu) << (8u * i);
    }
    return r;
}

/* the grid in the workgroup's shared memory (iq4xs_matvec.comp) */
shared uint GS[256];

void main()
{
    for (uint i = gl_LocalInvocationID.x; i < 256u; i += 64u)
        GS[i] = IQ3XXS_GRID[i];
    barrier();
    U1 W = U1(p.w);
    U4 X = U4(p.x);
    F Y = F(p.y);
    uint lane = gl_SubgroupInvocationID;
    uint grow = gl_WorkGroupID.y * 64u + gl_LocalInvocationID.x;
    uint row = min(grow, p.rows - 1u);
    uint v0 = gl_WorkGroupID.x * NV;
    uint xo[NV];
    for (uint v = 0; v < NV; v++)
        xo[v] = min(v0 + v, p.nv - 1u) * p.xs * 20u;
    float acc[NV];
    for (uint v = 0; v < NV; v++)
        acc[v] = 0.0;
    uint off = row * p.nb * BS;
    for (uint b = 0; b < p.nb; b++, off += BS) {
        uint base = off >> 2;
        uint wd[NW];
        for (uint k = 0; k < NW; k++)
            wd[k] = W.v[base + k];
        if ((off & 3u) != 0u) {
            for (uint k = 0; k + 1u < NW; k++)
                wd[k] = (wd[k] >> 16) | (wd[k + 1u] << 16);
            wd[NW - 1u] = wd[NW - 1u] >> 16;
        }
        float d = unpackHalf2x16(wd[0] & 0xffffu).x;
        /* group g: eight signed words (weights 4i..4i+3), its scale */
        uint q[64];
        int sc[8];
        for (uint g = 0; g < 8u; g++) {
            uint aux = half_at(wd, 66u + 4u * g) | (half_at(wd, 68u + 4u * g) << 16);
            sc[g] = 1 + 2 * int(aux >> 28);
            for (uint k = 0; k < 4u; k++) {
                uint sg = signs7((aux >> (7u * k)) & 127u);
                q[8u * g + 2u * k] = signed4(GS[byte_at(wd, 2u + 8u * g + 2u * k)], sg & 15u);
                q[8u * g + 2u * k + 1u] = signed4(GS[byte_at(wd, 3u + 8u * g + 2u * k)], sg >> 4);
            }
        }
        for (uint v = 0; v < NV; v++) {
            uvec4 xr[NX];
            for (uint j = 0; j < NX; j++)
                xr[j] = X.v[xo[v] + min(j * SG + lane, 19u)];
            int isum = 0;
            for (uint g = 0; g < 8u; g++) {
                uvec4 a0 = bc(xr, 2u * g), a1 = bc(xr, 2u * g + 1u);
                uint q0 = 8u * g;
                int s = dp(q[q0], a0.x) + dp(q[q0 + 1u], a0.y) + dp(q[q0 + 2u], a0.z) +
                        dp(q[q0 + 3u], a0.w) + dp(q[q0 + 4u], a1.x) + dp(q[q0 + 5u], a1.y) +
                        dp(q[q0 + 6u], a1.z) + dp(q[q0 + 7u], a1.w);
                isum += sc[g] * s;
            }
            float d8 = uintBitsToFloat(bc(xr, 18u).x);
            acc[v] = fma(d * 0.25 * d8, float(isum), acc[v]);
            xo[v] += 20u;
        }
    }
    if (grow < p.rows)
        for (uint v = 0; v < NV; v++)
            if (v0 + v < p.nv)
                Y.v[(v0 + v) * p.ys + row] = acc[v];
}

#version 450
// IQ3_XXS weights times up to NV Q8_K vectors, one row per invocation, as
// janas_iq3xxs_dot_ref computes them: 98 bytes a block (d, 64 grid indices
// of four levels each, then for each group of 32 a word of four 7-bit sign
// indices - the eighth bit their parity, ggml's ksigns_iq2xs - and the
// scale in its top four bits), each group's integer dot times 1 + 2 s, the
// block's exact integer sum in one fma with (d / 4) d8: the CPU's float
// operations, so the results agree bit for bit. Blocks start on 2-byte
// boundaries: their words are realigned. Activations shared across the
// subgroup as in q4k_matvec.comp.
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 64) in;
layout(constant_id = 0) const uint NV = 8;
layout(constant_id = 1) const uint SG = 8;
const uint NX = (19u + SG - 1u) / SG;
const uint BS = 98u, NW = (BS + 3u) / 4u + 1u;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer U1 { uint v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer U4 { uvec4 v[]; };
